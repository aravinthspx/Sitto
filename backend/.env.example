# ─── Runtime ──────────────────────────────────────────────────────────────────
# "production" (default) or "development". Production disables the debugger,
# enables HSTS and requires ALLOWED_ORIGINS to be set.
APP_ENV=production
# Only honoured when APP_ENV=development. NEVER enable on a public server.
FLASK_DEBUG=0
PORT=5000

# Browser origins allowed to call the API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://sitto.your-college.edu.in
# Public URL of the frontend — used in verification and password-reset emails
FRONTEND_URL=https://sitto.your-college.edu.in
# Number of reverse proxies (nginx, load balancer) in front of the API
TRUSTED_PROXY_COUNT=1
# Rate-limit storage. memory:// is per-process; use redis://host:6379 with several workers
RATELIMIT_STORAGE_URI=memory://

# ─── Supabase (do NOT share these publicly) ───────────────────────────────────
# Dashboard -> Project Settings -> API. The key must be the secret/service-role key
# and must only ever live on the server.
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ─── Accounts ─────────────────────────────────────────────────────────────────
# Only these email domains may sign up (comma-separated). Empty = anyone.
ALLOWED_EMAIL_DOMAINS=srmist.edu.in
MIN_PASSWORD_LENGTH=8
# Bump when the Privacy Policy changes; stored with each user's consent
PRIVACY_POLICY_VERSION=2026-10-17

# ─── Booking rules ────────────────────────────────────────────────────────────
MAX_SEATS_PER_STUDENT=4
BOOKING_START_HOUR=8
BOOKING_END_HOUR=17
SESSION_DURATION_MINS=60
MAX_BOOKING_HOURS=3
MAX_BOOKING_DAYS_AHEAD=3
# Campus time zone offset from UTC in minutes (IST = 330)
CAMPUS_UTC_OFFSET_MINS=330

# ─── Data retention (keep in sync with the Privacy Policy) ────────────────────
RETENTION_BOOKINGS_DAYS=365
RETENTION_NOTIFICATIONS_DAYS=90

# ─── Phone notifications (Web Push) ───────────────────────────────────────────
# Generate a key pair per environment:  python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use to reach you about abuse
VAPID_SUBJECT=mailto:it-support@your-college.edu.in
# Optional: separate secret for one-tap SeatSure buttons (defaults to the VAPID private key)
PUSH_ACTION_SECRET=
# Minutes before a booking starts to send the check-in reminder
CHECKIN_REMINDER_MINUTES=10
